{
  "name": "@yasmee_ogo/kit",
  "version": "0.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/y-naaz/kit.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./package/index.js",
  "types": "./package/index.d.ts",
  "exports": {
    ".": {
      "types": "./package/index.d.ts",
      "svelte": "./package/index.js",
      "default": "./package/index.js"
    }
  },
  "files": [
    "package"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "type-decoder": "^2.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:fix:generated": "eslint './src/generated/**/*.{js,ts}' --fix",
    "format:generated": "prettier --write ./src/generated/**/*",
    "format": "prettier --write .",
    "lint": "eslint .",
    "generate:types": "type-crafter generate typescript-with-decoders ./schema/product.yaml ./src/generated/types SingleFile SingleFile && pnpm run lint:fix:generated && pnpm run format:generated",
    "package": "rm -rf src/lib/generated package && cp -R src/generated src/lib/generated && (svelte-package -o package; e=$?; rm -rf src/lib/generated; find src/generated -name '*.d.ts' -delete; [ $e -eq 0 ] && node scripts/fix-package-imports.mjs; exit $e)",
    "prepublishOnly": "pnpm package",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm package && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.14.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.6",
    "type-crafter": "^0.22.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.0"
  }
}
